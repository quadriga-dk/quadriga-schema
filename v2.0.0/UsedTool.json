{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/UsedTool.json",
  "title": "UsedTool – Verwendetes Werkzeug",
  "description": "Werkzeug / (Software-)Tool, das im Verlauf der OER benötigt wird.",
  "type": "object",
  "required": ["name", "url"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "name – Name des Tools",
      "description": "Name eines in der OER verwendeten Werzeugs / (Software-)Tools (z.B. \"Programmiersprache R\")",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lom": {
          "relation": "skos:closeMatch",
          "target": "4.4.1.2 Technical Requirement OrComposite Name"
        },
        "lrmi": null,
        "modalia": null,
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:name"
        }
      }
    },
    "url": {
      "title": "url – URL des Tools",
      "description": "Bevorzugt persistenter Link zum verwendeten Werkzeug / (Software-)Tool (z.B. nach LCSH (https://id.loc.gov/authorities/subjects.html))",
      "type": "string",
      "format": "uri",
      "x-mappings": {
        "dc": {
          "relation": "skos:exactMatch",
          "target": "dc:identifier"
        },
        "dcat": null,
        "dcterms": {
          "relation": "skos:exactMatch",
          "target": "dcterms:identifier"
        },
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        }
      }
    }
  },
  "x-mappings": {
    "dc": null,
    "dcat": {
      "relation": "skos:closeMatch",
      "target": "dcterms:requires"
    },
    "dcterms": {
      "relation": "skos:closeMatch",
      "target": "dcterms:requires"
    },
    "hermes": null,
    "lom": {
      "relation": "skos:closeMatch",
      "target": "4.4 Technical Requirement"
    },
    "lrmi": null,
    "modalia": {
      "relation": "skos:closeMatch",
      "target": "dcterms:requires"
    },
    "schema": {
      "relation": "skos:closeMatch",
      "target": "schema:softwareRequirements"
    }
  }
}
