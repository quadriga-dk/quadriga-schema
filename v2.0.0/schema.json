            }
          ],
          "schema": [
            {
              "relation": "skos:closeMatch",
              "target": "schema:competencyRequired"
            },
            {
              "relation": "skos:closeMatch",
              "target": "schema:coursePrerequisites"
            }
          ]
        }
      }
    },
    "usedToolLIST": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "UsedTool.json"
      }
    },
    "chapterLIST": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "Chapter.json"
      },
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": {
          "relation": "skos:exactMatch",
          "target": "dcterms:hasPart"
        },
        "hermes": null,
        "lrmi": null,
        "modalia": {
