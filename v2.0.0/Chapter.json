{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/Chapter.json",
  "title": "Chapter – Kapitel",
  "description": "Ein Kapitel der OER",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "url",
    "timeRequired",
    "learningObjectiveLIST",
    "learningGoal"
  ],
  "properties": {
    "title": {
      "title": "title – Titel",
      "description": "Titel des Kapitels",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:title"
        },
        "dcat": null,
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:title"
        },
        "hermes": null,
        "lom": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:broadMatch",
          "target": "dcterms:title"
        },
        "schema": {
          "relation": "skos:broadMatch",
          "target": "schema:name"
        }
      }
    },
    "description": {
      "title": "description – Kapitelbeschreibung",
      "description": "Beschreibung des Kapitels",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:description"
        },
        "dcat": null,
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:description"
        },
        "hermes": null,
        "lom": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:broadMatch",
          "target": "dcterms:description"
        },
        "schema": {
          "relation": "skos:broadMatch",
          "target": "schema:name"
        }
      }
    },
    "url": {
      "title": "url – URL Kapitel",
      "description": "URL des Kapitelbeginns",
      "type": "string",
      "format": "uri",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:identifier"
        },
        "dcat": null,
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:identifier"
        },
        "hermes": null,
        "lom": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        }
      }
    },
    "timeRequired": {
      "title": "timeRequired – Bearbeitungszeit (Kapitel)",
      "description": "Geschätzte Bearbeitungsdauer des Kapitels im ISO 8691 Format (z.B. PT3H15M).",
      "$ref": "timeRequired.json"
    },
    "learningGoal": {
      "title": "learningGoal – Übergeordnetes Lernziel",
      "description": "Übergeordnetes Lernziel des Kapitels",
      "$comment": "Dieses Lernziel gibt einen groben Überblick über die zu erlernenden Inhalte des Kapitels.",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:description"
        },
        "dcat": null,
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:description"
        },
        "hermes": {
          "relation": "skos:closeMatch",
          "target": "10.5281/zenodo.8010617 learningObjectives",
          "$comment": "\"Lernziele\"\n\nHERMES nutzt die Lernzielmatrix (Petersen et al., 2025)"
        },
        "lrmi": {
          "relation": "skos:exactMatch",
          "target": "lrmi:teaches"
        },
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "modalia:hasLearningObjective"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:teaches"
        }
      }
    },
    "learningObjectiveLIST": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "LearningObjective.json"
      }
    },
    "supplementalMaterialLIST": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "SupplementalMaterial.json"
      }
    },
    "language": {
      "title": "language – Sprache des Kapitels",
      "description": "Sprache des Kapitels als ISO 639-1 Sprachcode",
      "$comment": "Nur nutzen, falls die Sprache des Kapitels von der Sprache der OER abweicht.",
      "$ref": "language.json"
    }
  },
  "x-mappings": {
    "dc": null,
    "dcat": null,
    "dcterms": {
      "relation": "skos:exactMatch",
      "target": "schema:Chapter"
    },
    "hermes": null,
    "lrmi": null,
    "modalia": null,
    "schema": {
      "relation": "skos:exactMatch",
      "target": "schema:Chapter"
    }
  }
}
