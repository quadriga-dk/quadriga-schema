{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/Chapter.json",
  "title": "Chapter – Kapitel",
  "description": "Beschreibung eines Kapitels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "url",
    "timeRequired",
    "learningObjectiveLIST",
    "learningGoal"
  ],
  "properties": {
    "title": {
      "title": "title – Kapitelüberschrift",
      "description": "Kapitelüberschrift.\n\nDieser Titel sollte beim Zitieren eine Kapitels genutzt werden.",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    },
    "description": {
      "title": "description – Kapitelinhaltsbeschreibung",
      "description": "Beschreibung des Kapitelinhalts.",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    },
    "url": {
      "title": "url – URL der Web-Ansicht",
      "description": "URL zum direkten Zugriff auf die erste Seite der 'Leseansicht' (Website) des Kapitel.",
      "type": "string",
      "format": "uri",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        }
      }
    },
    "timeRequired": {
      "title": "timeRequired – Bearbeitungszeit (Kapitel)",
      "description": "Geschätzte Bearbeitungsdauer des Kapitels.",
      "$ref": "timeRequired.json"
    },
    "learningGoal": {
      "title": "learningGoal – Groblernziel",
      "description": "Kurze Benennung des Groblernziels des Kapitels.",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": {
          "relation": "skos:exactMatch",
          "target": "lrmi:teaches"
        },
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "modalia:hasLearningObjective"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:teaches"
        }
      }
    },
    "learningObjectiveLIST": {
      "title": "learningObjectiveLIST – Lernziele",
      "description": "Liste der Lernziele des Kapitels",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "LearningObjective.json"
      },
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    },
    "supplementalMaterialLIST": {
      "title": "supplementalMaterialLIST – Ergänzende / Genutzte Materialien",
      "description": "Für die Bearbeitung des Kapitels notwendiges / weiterführendes Material.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "SupplementalMaterial.json"
      },
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    },
    "language": {
      "title": "language – Kapitelsprache",
      "description": "Sprache(n) des Kapitels. Überschreibt die auf Buchebene definierte Sprache für dieses Kapitel.",
      "$ref": "language.json"
    }
  },
  "x-mappings": {
    "dc": null,
    "dcat": null,
    "dcterms": null,
    "hermes": null,
    "lrmi": null,
    "modalia": null,
    "schema": {
      "relation": "skos:exactMatch",
      "target": "schema:Chapter"
    }
  }
}
