{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/timeRequired.json",
  "type": "string",
  "format": "duration",
  "x-mappings": {
    "dc": {
      "relation": "skos:broadMatch",
      "target": "dc:date"
    },
    "dcat": null,
    "dcterms": {
      "relation": "skos:closeMatch",
      "target": "dcterms:extent"
    },
    "hermes": {
      "$comment": "\"Dauer\"\n\nAngabe im Format \"D:hh:mm:ss\"",
      "relation": "skos:closeMatch",
      "target": "schema:duration"
    },
    "lom": {
      "relation": "skos:exactMatch",
      "target": "5.9 Educational Typical Learning Time"
    },
    "lrmi": {
      "relation": "skos:exactMatch",
      "target": "lrmi:timeRequired"
    },
    "modalia": {
      "relation": "skos:exactMatch",
      "target": "schema:timeRequired"
    },
    "schema": {
      "relation": "skos:exactMatch",
      "target": "schema:timeRequired"
    }
  }
}
