{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/SupplementalMaterial.json",
  "title": "SupplementalMaterial – Nachgenutztes Materiali",
  "description": "Nachgenutztes Material",
  "type": "object",
  "required": ["url", "title"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "title – Titel / Name",
      "description": "Titel oder Name des Nachgenutzten Materials",
      "$ref": "MultilingualText.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    },
    "url": {
      "title": "url – URL des Materials",
      "description": "Link zum nachgenutzten Material, bevorzugt persistent (z.B. DOI)",
      "type": "string",
      "format": "uri",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": {
          "relation": "skos:closeMatch",
          "target": "dcterms:references"
        },
        "hermes": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:url"
        }
      }
    }
  },
  "x-mappings": {
    "dc": null,
    "dcat": null,
    "dcterms": null,
    "hermes": null,
    "lrmi": null,
    "modalia": {
      "relation": "skos:closeMatch",
      "target": "https://w3id.org/citedcat-ap/isSupplementedBy"
    },
    "schema": null
  }
}
