{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/Author.json",
  "title": "Author – Autor:in",
  "description": "Ein/eine Autor:in im Sinne des Urheberrechts\n\nEine natürliche Person",
  "type": "object",
  "required": ["givenName", "familyName"],
  "additionalProperties": false,
  "properties": {
    "familyName": {
      "title": "familyName – Nachname",
      "description": "Nachname des/der Autor:in",
      "$comment": "Liegt kein Nachname vor, so wird dieses Feld mit einer leeren Zeichenkette belegt und alle Namen werden in das Feld givenName eingetragen.",
      "type": "string",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "schema:familyName"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:familyName"
        }
      }
    },
    "givenName": {
      "title": "givenName – Vorname",
      "description": "Vorname des/der Autor:in",
      "type": "string",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "schema:givenName"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:givenName"
        }
      }
    },
    "orcid": {
      "title": "orcid – ORCID",
      "description": "ORCID des/der Autor:in als URI (https://orcid.org/XXXX-XXXX-XXXX-XXXX).",
      "$ref": "orcid.json"
    },
    "credit": {
      "title": "credit – CRediT-Rolle",
      "description": "Eine in der OER-Entwicklung übernommene Rolle des/der Autor:in nach CRediT Taxonomie (siehe https://credit.niso.org/).",
      "$ref": "credit.json"
    },
    "affiliation": {
      "type": "string",
      "title": "affiliation – Institutionelle Zugehörigkeit",
      "description": "Institutionelle Zugehörigkeit des/der Autor:in (nach Möglichkeit mit ROR)",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": null,
        "schema": null
      }
    }
  },
  "x-mappings": {
    "dc": {
      "relation": "skos:broadMatch",
      "target": "dc:creator"
    },
    "dcat": null,
    "dcterms": {
      "relation": "skos:broadMatch",
      "target": "dcterms:creator"
    },
    "hermes": {
      "$comment": "HERMES Attribut #3: Autor:innen",
      "relation": "skos:broadMatch",
      "target": "dcterms:creator"
    },
    "lrmi": null,
    "modalia": {
      "$comment": "MoDALIA re-definiert `schema:author` zur Liste der Autor:innen. Damit ist dort `schema:author` nicht mehr genau eine Autor:in.",
      "relation": "skos:closeMatch",
      "target": "schema:author"
    },
    "schema": {
      "relation": "skos:exactMatch",
      "target": "schema:author"
    }
  }
}
