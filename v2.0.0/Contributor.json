{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadriga-dk.github.io/quadriga-schema/v2.0.0/Contributor.json",
  "title": "Contributor – Mitarbeiter:in / Beitragende:r",
  "description": "Ein/eine Beitragende:r im Sinne des Urheberrechts\n\nEine natürliche Person",
  "type": "object",
  "required": ["givenName", "familyName"],
  "additionalProperties": false,
  "properties": {
    "familyName": {
      "title": "familyName – Nachname",
      "description": "Nachname der/des Beitragenden",
      "$comment": "Liegt kein Nachname vor, so wird dieses Feld mit einer leeren Zeichenkette belegt und alle Namen werden in das Feld givenName eingetragen.",
      "type": "string",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:contributor"
        },
        "dcat": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "hermes": {
          "$comment": "\"Mitwirkende\"\n\nTeil eines Listenelements für HERMES-Attribut \"Mitwirkende\".",
          "relation": "skos:closeMatch",
          "target": "dcterms:contributor"
        },
        "lom": {
          "$comment": "2.3.1 Life Cycle Contribute Role kann nicht \"author\" sein.",
          "relation": "skos:closeMatch",
          "target": "2.3.2 Life Cycle Contribute Entity"
        },
        "lrmi": null,
        "modalia": {
          "$comment": "In MoDALIA nur definiert über \"Contribution\".",
          "relation": "skos:exactMatch",
          "target": "schema:familyName"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:familyName"
        }
      }
    },
    "givenName": {
      "title": "givenName – Vorname",
      "description": "Vorname der/des Beitragenden",
      "type": "string",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:contributor"
        },
        "dcat": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "hermes": {
          "$comment": "\"Mitwirkende\"\n\nTeil eines Listenelements für HERMES-Attribut \"Mitwirkende\".",
          "relation": "skos:closeMatch",
          "target": "dcterms:contributor"
        },
        "lom": {
          "$comment": "2.3.1 Life Cycle Contribute Role kann nicht \"author\" sein.",
          "relation": "skos:closeMatch",
          "target": "2.3.2 Life Cycle Contribute Entity"
        },
        "lrmi": null,
        "modalia": {
          "$comment": "In MoDALIA nur definiert über \"Contribution\".",
          "relation": "skos:exactMatch",
          "target": "schema:givenName"
        },
        "schema": {
          "relation": "skos:exactMatch",
          "target": "schema:givenName"
        }
      }
    },
    "orcid": {
      "title": "orcid – ORCID",
      "description": "ORCID der/des Beitragenden als URI (https://orcid.org/XXXX-XXXX-XXXX-XXXX).",
      "$ref": "orcid.json",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:contributor"
        },
        "dcat": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "hermes": {
          "$comment": "\"Mitwirkende\"\n\nTeil eines Listenelements für HERMES-Attribut \"Mitwirkende\".",
          "relation": "skos:closeMatch",
          "target": "dcterms:contributor"
        },
        "lom": {
          "$comment": "2.3.1 Life Cycle Contribute Role kann nicht \"author\" sein.",
          "relation": "skos:closeMatch",
          "target": "2.3.2 Life Cycle Contribute Entity"
        },
        "lrmi": null,
        "modalia": {
          "relation": "skos:exactMatch",
          "target": "http://w3id.org/nfdi4ing/metadata4ing#orcidId"
        },
        "schema": {
          "relation": "skos:broadMatch",
          "target": "schema:identifier"
        }
      }
    },
    "credit": {
      "title": "credit – CRediT-Rolle",
      "description": "Eine in der OER-Entwicklung übernommene Rolle der/des Beitragenden nach CRediT Taxonomie (siehe https://credit.niso.org/).",
      "$ref": "credit.json",
      "x-mappings": {
        "dc": null,
        "dcat": null,
        "dcterms": null,
        "hermes": null,
        "lrmi": null,
        "modalia": {
          "$comment": "In MoDALIA ist es nur möglich dies über eine \"Contribution\" zu definieren.",
          "relation": "skos:closeMatch",
          "target": "http://id.loc.gov/ontologies/bibframe/role"
        },
        "schema": {
          "relation": "skos:closeMatch",
          "target": "schema:roleName"
        }
      }
    },
    "affiliation": {
      "type": "string",
      "title": "affiliation – Institutionelle Zugehörigkeit",
      "description": "Institutionelle Zugehörigkeit der/des Beitragenden (nach Möglichkeit mit ROR)",
      "x-mappings": {
        "dc": {
          "relation": "skos:broadMatch",
          "target": "dc:contributor"
        },
        "dcat": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "dcterms": {
          "relation": "skos:broadMatch",
          "target": "dcterms:contributor"
        },
        "hermes": {
          "$comment": "\"Mitwirkende\"\n\nTeil eines Listenelements für HERMES-Attribut \"Mitwirkende\".",
          "relation": "skos:closeMatch",
          "target": "dcterms:contributor"
        },
        "lom": {
          "$comment": "2.3.1 Life Cycle Contribute Role kann nicht \"author\" sein.",
          "relation": "skos:closeMatch",
          "target": "2.3.2 Life Cycle Contribute Entity"
        },
        "lrmi": null,
        "modalia": null,
        "schema": {
          "relation": "skos:closeMatch",
          "target": "schema:affiliation"
        }
      }
    }
  },
  "x-mappings": {
    "dc": {
      "relation": "skos:broadMatch",
      "target": "dc:contributor"
    },
    "dcat": {
      "relation": "skos:broadMatch",
      "target": "dcterms:contributor"
    },
    "dcterms": {
      "relation": "skos:broadMatch",
      "target": "dcterms:contributor"
    },
    "hermes": {
      "$comment": "\"Mitwirkende\"\n\nTeilwerte können nach HERMES-Regeln zu einem Listenelement zusammengeführt werden.",
      "relation": "skos:closeMatch",
      "target": "dcterms:contributor"
    },
    "lom": {
      "$comment": "2.3.1 Life Cycle Contribute Role kann nicht \"author\" sein.",
      "relation": "skos:closeMatch",
      "target": "2.3.2 Life Cycle Contribute Entity"
    },
    "lrmi": null,
    "modalia": {
      "relation": "skos:closeMatch",
      "target": "modalia:Contributor"
    },
    "schema": {
      "relation": "skos:exactMatch",
      "target": "schema:contributor"
    }
  }
}
