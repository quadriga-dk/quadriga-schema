@startuml Chapter
scale 3
skinparam dpi 300
skinparam classAttributeIconSize 0
skinparam backgroundColor transparent
skinparam classFontSize 14
skinparam classAttributeFontSize 13
skinparam class {
  BackgroundColor white
  BorderColor #cccccc
  AttributeFontColor #000000
  Padding 4
}
skinparam note {
  BackgroundColor #f5f5f5
  BorderColor #cccccc
  FontColor #333333
}


class "Chapter" {
  MultilingualText title
  MultilingualText description
  URI url
  Duration timeRequired
  MultilingualText learningGoal
  LearningObjective[] learningObjective
  __
  <i><color:#666666>Language language?</i>
  <i><color:#666666>SupplementalMaterial[] supplementalMaterial?</i>
}

note bottom of "Chapter"
  Beschreibung eines Kapitels.

  - title: verwendet für Zitationen
  - description: Inhaltsbeschreibung
  - url: URL zur Webansicht
  - timeRequired: geschätzte Verarbeitungszeit
  - learningGoal: Lernziel
  - learningObjective: Lernziele
  - language (optional): Sprache
  - supplementalMaterial (optional): Zusatzmaterialien
end note

@enduml