@startuml LearningObjective
scale 3
skinparam dpi 300
skinparam classAttributeIconSize 0
skinparam backgroundColor transparent
skinparam classFontSize 14
skinparam classAttributeFontSize 13
skinparam class {
  BackgroundColor white
  BorderColor #cccccc
  AttributeFontColor #000000
  Padding 4
}
skinparam note {
  BackgroundColor #f5f5f5
  BorderColor #cccccc
  FontColor #333333
}


class "LearningObjective" {
  MultilingualText description
  Competency competency
  DataFlow dataFlow
  BloomsCategory bloomsCategory
  __
  <i><color:#666666>MultilingualText assessment?</i>
}

note bottom of "LearningObjective"
  Umfassende Beschreibung eines einzelnen Lernziels.

  - description: Formulierung des Lernziels
  - competency: QUADRIGA-Framework
  - dataFlow: Schritt im Datenfluss
  - bloomsCategory: Einordnung in die Bloomsche Taxonomie
  - assessment (optional): Lernstandskontrolle
end note

@enduml