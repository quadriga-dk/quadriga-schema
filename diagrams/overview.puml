@startuml overview
top to bottom direction
scale 1.5
skinparam dpi 300
skinparam classAttributeIconSize 0
skinparam backgroundColor transparent
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam ranksep 40
skinparam nodesep 25
skinparam class {
  BackgroundColor white
  BorderColor #cccccc
  AttributeFontColor #000000
  Padding 3
}
skinparam note {
  BackgroundColor #f5f5f5
  BorderColor #cccccc
  FontColor #333333
}

title QUADRIGA Metadata Schema - Entity Overview

' ===== MAIN ENTITY (TOP) =====
class "OpenEducationalResource" as oer <<Open Educational Resource>> {
  Root entity (Jupyter Book)
}

' ===== SECOND ROW: DIRECT CHILDREN =====
together {
  class "Author" <<Autor:in>> { }
  class "Contributor" <<Mitarbeiter:in>> { }
  class "Chapter" <<Kapitel>> {
    title
    description
    url
    timeRequired
    learningGoal
  }
}

' ===== THIRD ROW: CHAPTER CHILDREN =====
class "LearningObjective" <<Lernziel>> {
  description
  competency
  dataFlow
  bloomsCategory
  assessment?
}

' ===== RELATIONSHIPS FROM OpenEducationalResource =====
oer *-down- "Author" : 1..*
oer *-down- "Contributor" : 0..*
oer *-down- "Chapter" : 1..*

' ===== RELATIONSHIPS FROM Chapter =====
"Chapter" *-down- "LearningObjective" : 1..*

@enduml